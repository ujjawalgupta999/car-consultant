# ==============================================================================
# AMULATE SUMMER HACKATHON 2026: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Agent Execution Mode:
# 'mock'   -> Deterministic, 100% offline, zero-cost (Default for demo/testing)
# 'openai' -> OpenAI Agents SDK with GPT-4o
AGENT_MODE=mock

# Database Storage:
# 'auto'    -> Attempts MongoDB, cleanly falls back to JSON seed dataset
# 'mongodb' -> Requires live MongoDB instance
# 'json'    -> Always uses data/vehicles.json
STORAGE_BACKEND=mongodb
MONGODB_URI=

# Optional External API Keys (Leave blank for deterministic mock mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Tracing & Observability (Leave blank to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
